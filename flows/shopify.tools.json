  {
    "id": "shopify-store-availability",
    "name": "Find Nearest Stores With Stock",
    "description": "Find nearest stores that have a specific product variant in stock",
    "parameters": {
      "variantId": {
        "type": "string",
        "description": "Shopify product variant ID (e.g., 'gid://shopify/ProductVariant/12345')"
      },
      "city": {
        "type": "string",
        "description": "Customer's city to find nearest stores"
      },
      "storeLocations": {
        "type": "array",
        "description": "Array of store locations with coordinates"
      },
      "maxStores": {
        "type": "number",
        "description": "Maximum number of stores to return",
        "default": 3
      }
    },
    "required": [
      "variantId",
      "city",
      "storeLocations"
    ],
    "additionalProperties": false,
    "implementation": {
      "type": "local",
      "function": "findNearestStoresWithStock",
      "args": [
        "variantId",
        "city",
        "storeLocations",
        "maxStores"
      ],
      "timeout": 10000
    },
    "security": {
      "requiresAuth": false,
      "auditLevel": "low",
      "dataClassification": "public",
      "rateLimit": {
        "requests": 20,
        "window": 60000
      }
    },
    "returns": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "every path; false on inventory failure or any caught exception"
        },
        "error": {
          "type": "string",
          "description": "present when success:false: getStoreInventory's error ('Product variant not found', GraphQL message, 'Failed to fetch inventory', or its exception message) (1989), or this function's exception message (2048), e.g. geocode failure 'Could not geocode city: <city> after 2 retries' or a TypeError from a malformed storeLocations"
        },
        "found": {
          "type": "boolean",
          "description": "present when success:true — false (2029) when no stocked store matched, true (2038) otherwise"
        },
        "message": {
          "type": "string",
          "enum": [
            "This product is currently not available for in-store pickup at any location."
          ],
          "description": "present only when found:false (2032)"
        },
        "productTitle": {
          "type": "string",
          "description": "present when success:true — variant.product?.title (1972)"
        },
        "variantTitle": {
          "type": "string",
          "description": "present when success:true — ProductVariant.title, e.g. 'Default Title'"
        },
        "stores": {
          "type": "array",
          "description": "present only when found:true; 1..maxStores entries sorted by distance ascending",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "description": "from the caller's storeLocations entry (tenant data, not typed by code; .toLowerCase() is called on it, so a string)",
                "type": "string"
              },
              "city": {
                "type": "string",
                "description": "from storeLocations (.toLowerCase() called)"
              },
              "address": {
                "description": "from storeLocations, passed through untyped"
              },
              "state": {
                "description": "from storeLocations, passed through untyped"
              },
              "phone": {
                "description": "from storeLocations, passed through untyped (may be absent)"
              },
              "available": {
                "type": "number",
                "description": "Shopify 'available' quantity at the matched location, > 0 (1963, 2000)"
              },
              "distance": {
                "type": "number",
                "description": "miles, Haversine from geocoded city (calculateDistance:1239, R=3959)"
              }
            },
            "required": [
              "name",
              "city",
              "available",
              "distance"
            ]
          }
        },
        "totalStoresWithStock": {
          "type": "number",
          "description": "present only when found:true — count before the maxStores cut"
        }
      },
      "required": [
        "success"
      ]
    }
  },
