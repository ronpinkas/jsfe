  {
    "id": "shopify-search-policies",
    "name": "Search Store Policies",
    "description": "Search store policies, FAQs, return policy, shipping information, and contact details",
    "parameters": {
      "query": {
        "type": "string",
        "description": "Question about store policies"
      },
      "context": {
        "type": "string",
        "description": "Additional context",
        "default": ""
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false,
    "implementation": {
      "type": "local",
      "function": "searchShopifyPolicies",
      "args": [
        "query",
        "context"
      ],
      "timeout": 5000
    },
    "security": {
      "requiresAuth": false,
      "auditLevel": "low",
      "dataClassification": "public",
      "rateLimit": {
        "requests": 20,
        "window": 60000
      }
    },
    "returns": {
      "description": "Upstream search_shop_policies_and_faqs response, passed through unchanged. Live: a JSON ARRAY of {question, answer}.",
      "anyOf": [
        {
          "type": "array",
          "description": "Parsed MCP text payload (live probe icuracao.com 2026-09-30, mimeType application/json)",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string",
                "description": "FAQ question (upstream)"
              },
              "answer": {
                "type": "string",
                "description": "FAQ answer (upstream)"
              }
            }
          }
        },
        {
          "type": "object",
          "description": "Any object payload (upstream) — not observed; also the raw-result path (line 1751) {content:[...], isError}",
          "properties": {
            "content": {
              "description": "Present ONLY on the raw-result path: the MCP content ARRAY, not text"
            },
            "isError": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "string",
          "description": "MCP text content that was not valid JSON (line 1746) — e.g. an upstream error message returned with isError:true"
        },
        {
          "type": [
            "number",
            "boolean",
            "null"
          ],
          "description": "other JSON (line 1744)"
        }
      ]
    }
  },
  {
    "id": "shopify-lookup-orders",
    "name": "Lookup Customer Orders",
    "description": "Retrieve order history for a verified customer using phone or email. REQUIRES OTP verification first",
    "parameters": {
      "identifier": {
        "type": "string",
        "description": "Customer's verified phone number or email address"
      },
      "container": {
        "type": "object",
        "description": "Session container with OTP verification status"
      }
    },
    "required": [
      "identifier",
      "container"
    ],
    "additionalProperties": false,
    "implementation": {
      "type": "local",
      "function": "lookupCustomerOrders",
      "args": [
        "identifier",
        "container"
      ],
      "timeout": 15000
    },
    "security": {
      "requiresAuth": true,
      "authType": "otp",
      "auditLevel": "high",
      "dataClassification": "financial",
      "rateLimit": {
        "requests": 10,
        "window": 60000
      }
    },
    "returns": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "description": "every path. false on config/OTP/GraphQL/exception failures; true on 'no customer' and on success"
        },
        "error": {
          "type": "string",
          "description": "present when success:false. Literals: 'Shopify Admin API is not configured' (2059), 'Session container is invalid' (2068), 'OTP verification required before order lookup' (2076); otherwise the upstream GraphQL message / 'Failed to fetch orders' (2151) or exception message / 'Failed to lookup orders' (2200)"
        },
        "requiresOTP": {
          "type": "boolean",
          "enum": [
            true
          ],
          "description": "present (always true) only on the invalid-container (2068) and not-verified (2076) paths"
        },
        "message": {
          "type": "string",
          "description": "present only when no customer matched (2160): 'No orders found for this email' | 'No orders found for this phone'"
        },
        "customer": {
          "type": "object",
          "description": "present only on full success (2189)",
          "properties": {
            "firstName": {
              "type": [
                "string",
                "null"
              ],
              "description": "Shopify Customer.firstName (nullable upstream)"
            },
            "lastName": {
              "type": [
                "string",
                "null"
              ],
              "description": "Customer.lastName"
            },
            "email": {
              "type": [
                "string",
                "null"
              ],
              "description": "Customer.email"
            },
            "phone": {
              "type": [
                "string",
                "null"
              ],
              "description": "Customer.phone"
            }
          },
          "required": [
            "firstName",
            "lastName",
            "email",
            "phone"
          ]
        },
        "orders": {
          "type": "array",
          "description": "present when success:true — [] when no customer matched (2160); up to 10 newest-first orders otherwise (2178). A customer with no orders also yields [] WITH a customer object and without message.",
          "items": {
            "type": "object",
            "properties": {
              "orderNumber": {
                "type": "string",
                "description": "Order.name, e.g. '#1001'"
              },
              "orderId": {
                "type": "string",
                "description": "Order GID, gid://shopify/Order/<n>"
              },
              "createdAt": {
                "type": "string",
                "description": "ISO-8601 DateTime"
              },
              "financialStatus": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "displayFinancialStatus, upstream enum e.g. PAID, PENDING, REFUNDED, PARTIALLY_REFUNDED, VOIDED; nullable"
              },
              "overallStatus": {
                "type": "string",
                "description": "computed (2167-2176): displayFulfillmentStatus (e.g. UNFULFILLED, FULFILLED, PARTIALLY_FULFILLED) or 'CANCELLED' / 'CANCELLED:<cancelReason>' (reason omitted when OTHER), then ' <displayFinancialStatus>' appended when non-null, e.g. 'FULFILLED PAID'"
              },
              "total": {
                "type": "object",
                "description": "totalPriceSet.shopMoney (?.) — may be undefined",
                "properties": {
                  "amount": {
                    "type": "string",
                    "description": "Shopify Decimal serialized as a STRING in MAJOR units, e.g. '129.99' (NOT cents, unlike UCP)"
                  },
                  "currencyCode": {
                    "type": "string",
                    "description": "e.g. USD"
                  }
                }
              },
              "tracking": {
                "type": "array",
                "description": "fulfillments[0].trackingInfo — ONLY the first fulfillment's; undefined when the order has no fulfillments",
                "items": {
                  "type": "object",
                  "properties": {
                    "number": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "tracking number"
                    },
                    "url": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "tracking URL"
                    }
                  }
                }
              },
              "shippingAddress": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Order.shippingAddress (nullable upstream)",
