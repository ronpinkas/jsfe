[
  {
    "id": "shopify-search-products",
    "name": "Search Shopify Products",
    "description": "Search for products in the store catalog using natural language queries",
    "parameters": {
      "query": {
        "type": "string",
        "description": "Natural language search query (e.g., '65 inch TV', 'red dress size medium')"
      },
      "context": {
        "type": "string",
        "description": "Additional context about the search",
        "default": "Customer browsing"
      },
      "limit": {
        "type": "integer",
        "description": "Maximum number of results to return",
        "default": 5
      },
      "language": {
        "type": "string",
        "description": "BCP 47 language tag for search relevance / localization (e.g., 'en', 'es'). Falls back to 'en'.",
        "default": "en"
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false,
    "implementation": {
      "type": "local",
      "function": "searchShopifyProducts",
      "args": [
        "query",
        "context",
        "limit",
        "language"
      ],
      "timeout": 10000
    },
    "security": {
      "requiresAuth": false,
      "auditLevel": "low",
      "dataClassification": "public",
      "rateLimit": {
        "requests": 30,
        "window": 60000
      }
    },
    "returns": {
      "description": "Upstream Shopify UCP search_catalog response, passed through unchanged. Object branch describes the UCP shape per CLAUDE.md and a live probe; the code itself reads none of it.",
      "anyOf": [
        {
          "type": "object",
          "description": "UCP search_catalog payload (parsed from the MCP text item)",
          "properties": {
            "ucp": {
              "type": "object",
              "description": "UCP envelope {version, status, services, capabilities, ...} (upstream)"
            },
            "products": {
              "type": "array",
              "description": "Matched products, up to pagination.limit (flow passes 5)",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "product GID, gid://shopify/Product/<n>"
                  },
                  "title": {
                    "type": "string",
                    "description": "upstream"
                  },
                  "url": {
                    "type": "string",
                    "description": "storefront URL, .../products/<handle> (CLAUDE.md)"
                  },
                  "handle": {
                    "type": "string",
                    "description": "upstream"
                  },
                  "description": {
                    "type": "object",
                    "description": "upstream, {html}"
                  },
                  "price_range": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "object",
                        "description": "UCP money — amount in MINOR units (cents)",
                        "properties": {
                          "amount": {
                            "type": "number",
                            "description": "integer cents, e.g. 8999 = $89.99 (CLAUDE.md + live probe)"
                          },
                          "currency": {
                            "type": "string",
                            "description": "ISO currency, e.g. USD"
                          }
                        }
                      },
                      "max": {
                        "type": "object",
                        "description": "UCP money — amount in MINOR units (cents)",
                        "properties": {
                          "amount": {
                            "type": "number",
                            "description": "integer cents, e.g. 8999 = $89.99 (CLAUDE.md + live probe)"
                          },
                          "currency": {
                            "type": "string",
                            "description": "ISO currency, e.g. USD"
                          }
                        }
                      }
                    }
                  },
                  "list_price_range": {
                    "type": "object",
                    "description": "compare-at range, same shape as price_range (CLAUDE.md)"
                  },
                  "variants": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "variant GID, gid://shopify/ProductVariant/<n>"
                        },
                        "sku": {
                          "type": "string",
                          "description": "upstream"
                        },
                        "title": {
                          "type": "string",
                          "description": "upstream, e.g. 'Default Title'"
                        },
                        "price": {
                          "type": "object",
                          "description": "UCP money — amount in MINOR units (cents)",
                          "properties": {
                            "amount": {
                              "type": "number",
                              "description": "integer cents, e.g. 8999 = $89.99 (CLAUDE.md + live probe)"
                            },
                            "currency": {
                              "type": "string",
                              "description": "ISO currency, e.g. USD"
                            }
                          }
                        },
                        "availability": {
                          "type": "object",
                          "properties": {
                            "available": {
                              "type": "boolean",
                              "description": "upstream in-stock flag (CLAUDE.md: variants[].availability.available)"
                            }
                          }
                        },
                        "checkout_url": {
                          "type": "string",
                          "description": "upstream"
                        }
                      }
                    }
                  },
                  "options": {
                    "type": "array"
                  },
                  "media": {
                    "type": "array"
                  }
                }
              }
            },
            "pagination": {
              "type": "object",
              "properties": {
                "has_next_page": {
                  "type": "boolean",
                  "description": "upstream"
                },
                "cursor": {
                  "type": "string",
                  "description": "upstream"
                }
              }
            },
            "messages": {
              "type": "array",
              "description": "UCP messages (upstream)"
            }
          },
          "required": []
        },
        {
          "type": "string",
          "description": "MCP text content that was not valid JSON (line 1746) — e.g. an upstream error message returned with isError:true"
        },
        {
          "description": "Any other JSON value JSON.parse can yield from the MCP text item (line 1744), upstream-defined",
          "type": [
            "array",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "object",
          "description": "Raw JSON-RPC result when it has no text content item (line 1751)",
          "properties": {
            "content": {
              "type": "array",
              "description": "MCP content items (upstream)"
            },
            "isError": {
              "type": "boolean",
              "description": "MCP tool error flag (upstream)"
            }
          }
        }
      ]
    }
  },
